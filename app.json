{
  "expo": {
    "name": "Domani",
    "slug": "domani-app",
    "version": "1.1.1",
    "orientation": "portrait",
    "scheme": "domani",
    "icon": "./assets/AppIcon-sage.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/Splash-sage.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF8F5"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.baitedz.domani-app",
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:www.domani-app.com"],
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-adaptive-icon-foreground.png",
        "backgroundColor": "#FAF8F5"
      },
      "splash": {
        "image": "./assets/Splash-sage.png",
        "resizeMode": "contain",
        "backgroundColor": "#FAF8F5"
      },
      "package": "com.baitedz.domaniapp",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.domani-app.com",
              "pathPrefix": "/auth/callback"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-font",
      "expo-web-browser",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#7D9B8A"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "pixelverse-studios",
          "project": "domani-app"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5341e2b9-b8e9-4faf-8caf-f4d3847fd92e"
      },
      "posthogApiKey": "phc_zIMNv3qWfQHyXlXgTnQJEaomiOXO38LTNS6JyNddK57"
    }
  }
}
