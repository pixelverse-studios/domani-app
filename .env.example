# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google OAuth (optional - for reference only, not used in app code)
# Get these from: https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# RevenueCat Configuration
# Get these from: https://app.revenuecat.com → Project Settings → API Keys
# See docs/REVENUECAT_SETUP.md for full setup guide
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your_ios_key_here
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your_android_key_here
# RevenueCat entitlement identifier (environment-specific)
# Staging example: Domani Staging Lifetime
# Production example: Domani Lifetime
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=Domani Staging Lifetime

# Discord Webhook (for support/feedback notifications)
# Create a webhook in Discord: Server Settings → Integrations → Webhooks
EXPO_PUBLIC_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-url

# PostHog Analytics
# Get this from: https://us.posthog.com → Project Settings → Project API Key
EXPO_PUBLIC_POSTHOG_KEY=phc_your_project_api_key_here

# Sentry Error Monitoring
# DSN: Get from https://sentry.io → Settings → Projects → domani-app → Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=https://your-key@o123456.ingest.us.sentry.io/your-project-id

# Sentry Auth Token (required for local Xcode/Android Studio builds)
# Generate at: https://sentry.io/settings/auth-tokens/
# Required scopes: org:ci, project:releases
SENTRY_AUTH_TOKEN=your-auth-token-here
